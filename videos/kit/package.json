{
  "name": "@musiccharts/video-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Building blocks for Music Charts Tools product videos, consumed as TypeScript source.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./brand": "./src/brand/index.ts",
