{
  "name": "@musiccharts/film-{{FILM_SLUG}}",
  "version": "0.0.0",
  "private": true,
  "description": "A product video made with the video kit.",
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/@musiccharts/video-kit/scripts/link-browser.mjs",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "still": "remotion still Film out/still.png",
    "pacing": "node --import tsx node_modules/@musiccharts/video-kit/scripts/qa/pacingAudit.ts --sheet src/pacing.ts",
    "render": "node --import tsx node_modules/@musiccharts/video-kit/scripts/render/renderFilm.ts --entry src/index.ts --composition Film --out out/picture.mp4"
  },
  "dependencies": {
    "@eliwhite/scan-chart": "catalog:",
    "@musiccharts/video-kit": "workspace:*",
    "@remotion/cli": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remotion": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
