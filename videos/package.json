{
  "name": "musiccharts-videos",
  "private": true,
  "description": "Product videos for Music Charts Tools: the shared video kit, its gallery, and one package per film.",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "typecheck": "pnpm --filter \"./**\" --if-present typecheck",
    "test": "pnpm --filter \"./**\" --if-present test",
    "gallery": "pnpm --filter @musiccharts/video-gallery studio",
    "new-film": "node --import tsx kit/scripts/new-film.ts",
    "browser": "pnpm --filter @musiccharts/video-kit exec remotion browser ensure"
  }
}
